# ==============================================
# 🏋️‍♂️ The Club — .gitignore
# Purpose: Keep secrets, build files, and temp data out of Git.
# Applies to the entire The Club project and all submodules.
# ==============================================

# ----------------------------
# 🧩 1. ENVIRONMENT VARIABLES
# ----------------------------
# Contains passwords, API keys, DB URLs — never commit this!
.env

# ----------------------------
# 🏗️ 2. MAVEN / SPRING BOOT BUILDS
# ----------------------------
# Maven build output (target folder inside each microservice)
target/

# Maven wrapper files (generated during builds)
.mvn/
mvnw
mvnw.cmd

# Spring Boot application log files
*.log

# ----------------------------
# 🧱 3. IDE / EDITOR FILES
# ----------------------------
# IntelliJ IDEA, Eclipse, VSCode project settings
.idea/
.vscode/
*.iml
*.classpath
*.project
*.settings/

# Mac system files
.DS_Store

# ----------------------------
# 🐳 4. DOCKER FILES & CONTAINERS
# ----------------------------
# Docker build cache, volumes, etc.
**/docker-compose.override.yml
**/.docker/
**/tmp/

# ----------------------------
# 📦 5. OS / TEMPORARY FILES
# ----------------------------
# OS cache files or temporary editor files
Thumbs.db
*.swp
*.swo
*.bak

# ----------------------------
# 🧰 6. BACKUP OR PERSONAL NOTES
# ----------------------------
# Files generated by documentation or temporary scripts
*.txt
*.md.bak
notes/
backup/

# ----------------------------
# ⚙️ 7. TRINO / DATABASE DATA
# ----------------------------
# Prevent accidental DB dumps or volume mounts being committed
**/data/
**/db/
*.sql
*.db

# ==============================================
# ✅ Summary:
# - Keeps the repo clean and lightweight.
# - Protects your secrets (.env).
# - Safe for all microservices under 'the-club'.
# ==============================================

# Deployment secrets (scripts/generate-secrets.sh) and local database dumps
secrets/
backups/
