{
  "uid": "theclub-overview",
  "title": "The Club \u2014 Overview",
  "description": "Health, traffic, errors, latency and JVM/DB resources of every service.",
  "tags": [
    "the-club"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
