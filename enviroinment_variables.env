# 🌍 The Club — Environment Variables Template
# Copy this file as `.env` in your project root and update values as needed.

# ======================= GLOBAL SETTINGS =======================
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO

# ======================= MYSQL SETTINGS ========================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_USER_DB=userdb
MYSQL_AUTH_DB=authdb

# ======================= POSTGRES SETTINGS =====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ACTIVITY_DB=activitydb

# ======================= TRINO SETTINGS ========================
TRINO_HOST=trino
TRINO_PORT=8085

# ======================= JWT SETTINGS ==========================
JWT_SECRET=yourSecretKeyHere
JWT_EXPIRATION_MS=3600000

# ======================= SERVICE PORTS =========================
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
ACTIVITY_SERVICE_PORT=8083
GATEWAY_SERVICE_PORT=8080
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888

# ======================= CONFIG SERVICE ========================
CONFIG_GIT_URI=https://your-repo-url.git

# ======================= OTHER SETTINGS ========================
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
