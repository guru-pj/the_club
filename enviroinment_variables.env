# 🌍 The Club — Environment Variables Template
# Copy this file to `.env` in the project root and adjust (project-setup.sh does this on first run).
#
# NO SECRETS HERE. Passwords, signing keys and API secrets live as files in ./secrets/ (created by
# scripts/generate-secrets.sh, gitignored) and are mounted into only the containers that need them:
#   theclub.jwt.private-key / theclub.jwt.public-key   RS256 token signing key pair
#   theclub.security.internal-api-key                  service-to-service key
#   mysql-root-password, postgres-password              database administrators (backups, migrations)
#   db-<service>-password                               one least-privilege DB user per service
#   admin-password                                      first platform admin (login: ADMIN_EMAIL below)
#   smtp-password, razorpay-key-secret,                 third-party credentials — empty until you fill them in
#   razorpay-webhook-secret, strava-client-secret
# See docs/PRODUCTION.md before deploying anywhere other than your laptop.

# ======================= GLOBAL SETTINGS =======================
# dev = local defaults. prod = fail-fast checks (no placeholder secrets, no mock payments) — use it in production.
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO
# Zone used for event schedules, registration windows and leaderboard periods
APP_TIME_ZONE=Asia/Kolkata
# Public URL of the web app; used for links in emails (password reset, email verification)
APP_BASE_URL=http://localhost:3000

# ======================= DATABASES =============================
# Host ports are only published in development (docker-compose.override.yml, bound to 127.0.0.1)
MYSQL_PORT=3306
POSTGRES_PORT=5432
POSTGRES_ACTIVITY_DB=activitydb

# ======================= BACKUPS ===============================
# Daily dump time (container time zone = APP_TIME_ZONE) and how long dumps are kept
BACKUP_SCHEDULE=02:30
BACKUP_RETENTION_DAYS=14

# ======================= TRINO (development only) ==============
TRINO_PORT=8085

# ======================= AUTH ==================================
# Access tokens are short-lived; sessions continue through the httpOnly refresh cookie
JWT_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P14D
# Identifier of the current signing key (change it when rotating keys — see docs/PRODUCTION.md)
JWT_KEY_ID=k1
# Refresh cookie is sent only over HTTPS when true. false is ONLY for plain-HTTP local development.
AUTH_COOKIE_SECURE=false
# Users must confirm their email before logging in. Turned off for local development; true in production.
REQUIRE_EMAIL_VERIFICATION=false
# First platform admin (reviews club-owner applications); password: secrets/admin-password
ADMIN_EMAIL=admin@theclub.local
# Browser origins allowed to call the gateway directly (the web app itself is same-origin via nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================= RATE LIMITS (per client IP) ===========
# Login, register, password reset, email verification (POST)
RATE_LIMIT_STRICT_PER_MINUTE=10
# Every API call
RATE_LIMIT_GENERAL_PER_MINUTE=300

# ======================= PORTS =================================
# Published to the network: the web app. The gateway is published on 127.0.0.1 only.
WEB_APP_PORT=3000
GATEWAY_SERVICE_PORT=8080
# Development only (docker-compose.override.yml)
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
ACTIVITY_SERVICE_PORT=8083
CLUB_SERVICE_PORT=8084
EVENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888

# ======================= CONFIG SERVICE ========================
# native = serve bundled config; git = use CONFIG_GIT_URI
CONFIG_PROFILE=native
CONFIG_GIT_URI=https://your-repo-url.git

# ======================= EMAIL (notification-service) ==========
# Development: docker-compose.override.yml points this at Mailpit (UI http://localhost:8025).
# Production: your SMTP provider; the password goes in secrets/smtp-password.
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_STARTTLS=true
MAIL_FROM=The Club <no-reply@theclub.local>

# ======================= PAYMENTS (event-service) ==============
# Required. mock = local development only (no real money; refused when SPRING_PROFILES_ACTIVE=prod).
# razorpay = live gateway: set RAZORPAY_KEY_ID here, and secrets/razorpay-key-secret + secrets/razorpay-webhook-secret.
# Razorpay webhook URL: https://<your-host>/api/v1/payments/webhooks/razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=

# ======================= STRAVA (activity-service) =============
# Create an API application at https://www.strava.com/settings/api; client secret: secrets/strava-client-secret
STRAVA_CLIENT_ID=
# Strava redirects the browser here; the web app finishes the connection
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me-strava-verify-token

# ======================= SERVICE DISCOVERY =====================
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
