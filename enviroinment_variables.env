# 🌍 The Club — Environment Variables Template
# Copy this file to `.env` in the project root and adjust (project-setup.sh does this on first run).
#
# NO SECRETS HERE. Passwords, signing keys and API secrets live as files in ./secrets/ (created by
# scripts/generate-secrets.sh, gitignored) and are mounted into only the containers that need them:
#   theclub.jwt.private-key / theclub.jwt.public-key   RS256 token signing key pair
#   theclub.security.internal-api-key                  service-to-service key
#   mysql-root-password, postgres-password              database administrators (backups, migrations)
#   db-<service>-password                               one least-privilege DB user per service
#   admin-password                                      first platform admin (login: ADMIN_EMAIL below)
#   smtp-password, razorpay-key-secret,                 third-party credentials — empty until you fill them in
#   razorpay-webhook-secret, strava-client-secret
# See docs/PRODUCTION.md before deploying anywhere other than your laptop.

# ======================= GLOBAL SETTINGS =======================
# dev = local defaults. prod = fail-fast checks (no placeholder secrets, no mock payments) — use it in production.
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO
# Zone used for event schedules, registration windows and leaderboard periods
APP_TIME_ZONE=Asia/Kolkata
# Public URL of the web app; used for links in emails (password reset, email verification)
APP_BASE_URL=http://localhost:3000

# ======================= DATABASES =============================
# Host ports are only published in development (docker-compose.override.yml, bound to 127.0.0.1)
MYSQL_PORT=3306
POSTGRES_PORT=5432
POSTGRES_ACTIVITY_DB=activitydb

# ======================= BACKUPS ===============================
# Daily dump time (container time zone = APP_TIME_ZONE) and how long dumps are kept
BACKUP_SCHEDULE=02:30
BACKUP_RETENTION_DAYS=14
# Off-site copy of the dumps: `docker compose --profile offsite up -d backup-offsite`. Any rclone target; quote values
# containing ":" (e.g. endpoint='https://...'). Examples:
#   AWS S3:  :s3,provider=AWS,region=eu-west-1:my-backups/the-club   (+ RCLONE_S3_ACCESS_KEY_ID / RCLONE_S3_SECRET_ACCESS_KEY)
#   R2:      :s3,provider=Cloudflare,endpoint='https://<account>.r2.cloudflarestorage.com':my-backups/the-club
#   Azure:   :azureblob,account=<storage-account>:backups/the-club   (+ RCLONE_AZUREBLOB_KEY)
BACKUP_OFFSITE_TARGET=

# ======================= TRINO (development only) ==============
TRINO_PORT=8085

# ======================= AUTH ==================================
# Access tokens are short-lived; sessions continue through the httpOnly refresh cookie
JWT_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P14D
# Identifier of the current signing key (change it when rotating keys — see docs/PRODUCTION.md)
JWT_KEY_ID=k1
# Refresh cookie is sent only over HTTPS when true. false is ONLY for plain-HTTP local development.
AUTH_COOKIE_SECURE=false
# Users must confirm their email before logging in. Turned off for local development; true in production.
REQUIRE_EMAIL_VERIFICATION=false
# First platform admin (reviews club-owner applications); password: secrets/admin-password
ADMIN_EMAIL=admin@theclub.local
# Browser origins allowed to call the gateway directly (the web app itself is same-origin via nginx).
# https://localhost is the Android app (http://localhost when it was built for a plain-HTTP local server),
# capacitor://localhost the iOS app and tauri://localhost the macOS app;
# see docs/NATIVE_APPS.md
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,https://localhost,capacitor://localhost,tauri://localhost

# ======================= RATE LIMITS (per client IP) ===========
# Login, register, password reset, email verification (POST)
RATE_LIMIT_STRICT_PER_MINUTE=10
# Every API call
RATE_LIMIT_GENERAL_PER_MINUTE=300

# ======================= PORTS =================================
# Published to the network: the web app. The gateway is published on 127.0.0.1 only.
WEB_APP_PORT=3000
# Behind a TLS proxy on this host (e.g. Caddy): WEB_APP_PORT=127.0.0.1:3000 and REAL_IP_FROM=172.16.0.0/12 so the
# real client IP (not the proxy's) is used for rate limiting. Comma-separate several ranges. Empty = trust nobody.
REAL_IP_FROM=
GATEWAY_SERVICE_PORT=8080
# Development only (docker-compose.override.yml)
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
ACTIVITY_SERVICE_PORT=8083
CLUB_SERVICE_PORT=8084
EVENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888

# ======================= CONFIG SERVICE ========================
# native = serve bundled config; git = use CONFIG_GIT_URI
CONFIG_PROFILE=native
CONFIG_GIT_URI=https://your-repo-url.git

# ======================= EMAIL (notification-service) ==========
# Development: docker-compose.override.yml sends everything to Mailpit over SMTP (UI http://localhost:8025).
# Production: MAIL_PROVIDER=zeptomail with the Send Mail token in secrets/zeptomail-token — see docs/EMAIL_SETUP.md.
#   zeptomail = Zoho ZeptoMail HTTP API (recommended) | smtp = any SMTP server (MAIL_HOST..., secrets/smtp-password)
#   log = don't send, only log (refused with SPRING_PROFILES_ACTIVE=prod)
MAIL_PROVIDER=smtp
# ZeptoMail region endpoint: .in (India), .com (US), .eu (EU), .com.au (Australia), .jp, .ca, .sa
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# Optional reply-to address for all emails
MAIL_REPLY_TO=
# Staging only: deliver EVERY email to this one address (original recipient shown in the subject)
MAIL_REDIRECT_ALL_TO=
# Legacy switch, used only when MAIL_PROVIDER is blank (true = smtp, false = log)
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_STARTTLS=true
MAIL_FROM=The Club <no-reply@theclub.local>

# ======================= PAYMENTS (event-service) ==============
# Required. mock = local development only (no real money; refused when SPRING_PROFILES_ACTIVE=prod).
# razorpay = live gateway: set RAZORPAY_KEY_ID here, and secrets/razorpay-key-secret + secrets/razorpay-webhook-secret.
# Razorpay webhook URL: https://<your-host>/api/v1/payments/webhooks/razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
# Currency of new events when the owner doesn't choose one (ISO 4217: INR, USD, EUR, GBP, AUD, ...)
EVENTS_DEFAULT_CURRENCY=INR

# ======================= STRAVA (activity-service) =============
# Create an API application at https://www.strava.com/settings/api (docs/STRAVA_SETUP.md);
# client secret goes in secrets/strava-client-secret
STRAVA_CLIENT_ID=
# Strava redirects the browser here; the web app finishes the connection
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me-strava-verify-token
# Public HTTPS URL Strava pushes activity events to; used when an admin creates the push subscription
# (POST /api/v1/strava/admin/subscription). Example: https://club.example.com/api/v1/strava/webhook
STRAVA_WEBHOOK_CALLBACK_URL=
# How many days back the first sync of a newly connected athlete imports
STRAVA_INITIAL_SYNC_DAYS=90
# Tokens are encrypted at rest with secrets/strava-token-encryption-key (created by scripts/generate-secrets.sh).
# Full setup guide: docs/STRAVA_SETUP.md

# ======================= UPLOADS (images and private documents) =====
# Defaults use the bundled SeaweedFS container and serve images at /media through the web app. For an external
# S3-compatible store (AWS S3, Cloudflare R2, ...), set the endpoint, bucket and access key here, put its secret key
# in secrets/media-s3-secret-key, and set MEDIA_PUBLIC_BASE_URL to the bucket's public URL. Google Cloud Storage and
# Azure Blob Storage: MEDIA_PROVIDER=gcs|azure. See docs/PRODUCTION.md §6a and docs/CLOUD_DEPLOYMENT.md.
MEDIA_PROVIDER=s3
MEDIA_S3_ENDPOINT=http://seaweedfs:8333
MEDIA_S3_BUCKET=media
MEDIA_S3_ACCESS_KEY=theclub-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=/media
# Optional: a separate, never-public bucket for private documents (club application proofs)
MEDIA_PRIVATE_BUCKET=

# ======================= OBSERVABILITY =========================
# Used with docker-compose.observability.yml (Prometheus, Grafana, Tempo, Loki). See docs/OBSERVABILITY.md.
# Fraction of requests traced: 1.0 in development, 0.1 is a good start in production.
TRACING_SAMPLING_PROBABILITY=1.0
# UIs, bound to 127.0.0.1 only (Grafana user "admin", password in secrets/grafana-admin-password)
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
PROMETHEUS_RETENTION=15d

# ======================= SERVICE DISCOVERY =====================
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
