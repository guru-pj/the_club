# 🌍 The Club — Environment Variables Template
# Copy this file as `.env` in your project root and update values as needed.
# (project-setup.sh / project-setup.bat do this automatically on first run.)

# ======================= GLOBAL SETTINGS =======================
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO
# Zone used for event schedules, registration windows and leaderboard periods
APP_TIME_ZONE=Asia/Kolkata

# ======================= MYSQL SETTINGS ========================
# user, auth, club, event and notification services share this MySQL; each has its own database
# (created automatically via createDatabaseIfNotExist=true)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_USER_DB=userdb
MYSQL_AUTH_DB=authdb
MYSQL_CLUB_DB=clubdb
MYSQL_EVENT_DB=eventdb
MYSQL_NOTIFICATION_DB=notificationdb

# ======================= POSTGRES SETTINGS =====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ACTIVITY_DB=activitydb

# ======================= TRINO SETTINGS ========================
TRINO_HOST=trino
TRINO_PORT=8085

# ======================= SECURITY ==============================
# HS256 signing key shared by all services — at least 32 characters. CHANGE THIS outside local dev.
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-bytes
# Access token lifetime (ISO-8601 duration) and refresh token lifetime
JWT_EXPIRATION=PT1H
JWT_REFRESH_EXPIRATION=P14D
# Shared key for service-to-service /internal/** calls. CHANGE THIS outside local dev.
INTERNAL_API_KEY=change-me-dev-only-internal-key
# First platform admin (reviews club owner verification requests). Leave blank to skip.
ADMIN_EMAIL=admin@theclub.local
ADMIN_PASSWORD=change-me-admin
# Comma-separated origins allowed to call the gateway from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================= SERVICE PORTS =========================
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
ACTIVITY_SERVICE_PORT=8083
CLUB_SERVICE_PORT=8084
EVENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
GATEWAY_SERVICE_PORT=8080
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888
WEB_APP_PORT=3000

# ======================= CONFIG SERVICE ========================
# native = serve bundled config; git = use CONFIG_GIT_URI
CONFIG_PROFILE=native
CONFIG_GIT_URI=https://your-repo-url.git

# ======================= EMAIL (notification-service) ==========
# Mailpit (in docker-compose) catches all mail locally: UI at http://localhost:8025
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=The Club <no-reply@theclub.local>

# ======================= PAYMENTS (event-service) ==============
# mock = local development (no real money); razorpay = live gateway
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ======================= STRAVA (activity-service) =============
# Create an API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Strava redirects the browser here; the web app finishes the connection
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=change-me-strava-verify-token

# ======================= OTHER SETTINGS ========================
EUREKA_SERVER_URL=http://discovery-service:8761/eureka
